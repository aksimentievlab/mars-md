< void Configuration::readPotentialSchedule() {
< 	FILE* inp = fopen(potentialScheduleFile.val(), "r");
< 	char line[256];
< 	// int capacity = 256;
< 	// numBondAngles = 0;
< 	// bondAngles = new BondAngle[capacity];
< 
< 	// If the file cannot be found, exit the program
< 	if (inp == NULL) {
< 		printf("WARNING: Could not open `%s'.\n", potentialScheduleFile.val());
< 		printf("This simulation will not use potential swapping\n");
< 		return;
< 	}
< 
< 	while(fgets(line, 256, inp)) {
< 		if (line[0] == '#') continue;
< 		String s(line);
< 		int numTokens = s.tokenCount();
< 		String* tokenList = new String[numTokens];
< 		s.tokenize(tokenList);
< 
< 		// Legitimate inputs have at least 4 tokens and and even number
< 		// PotentialType | PotentialIndex | Step1 | Value1 | [Step2 | Value2] ...
< 		if (numTokens < 4 || 2*(numTokens/2) != numTokens) {
< 			printf("WARNING: Invalid potential schedule input line: %s\n", line);
< 			continue;
< 		}
< 
< 		// Discard any empty line
< 		if (tokenList == NULL) continue;
< 
< 		PotentialSchedule::PotentialType type;
< 		if (tokenList[0] == "TYPE") {
< 		    type = PotentialSchedule::TYPE;
< 		// } else if (tokenList[0] == "NONBONDED") {
< 		//     type = PotentialSchedule::NONBONDED;
< 		} else if (tokenList[0] == "BOND") {
< 		    type = PotentialSchedule::BOND;
< 		} else if (tokenList[0] == "ANGLE") {
< 		    type = PotentialSchedule::ANGLE;
< 		} else if (tokenList[0] == "DIHEDRAL") {
< 		    type = PotentialSchedule::DIHEDRAL;
< 		} else {
< 		    printf("Error reading potential type in potential schedule; exiting\n");
< 		    exit(-1);
< 		}
< 
< 		size_t idx = -1;
< 
< 		{
< 		    String* idx_tokens;
< 		    int nidx,a,b;
< 		    switch (type) {
< 		    case PotentialSchedule::NONBONDED:
< 			//
< 			nidx = tokenList[1].tokenCount('@');
< 			assert(nidx == 2);
< 			idx_tokens = new String[nidx];
< 			a = atoi(idx_tokens[0]);
< 			b = atoi(idx_tokens[1]);
< 			
< 			for (int i = 0; i < numParts*numParts; ++i) {
< 			    if (partTableIndex0[i] == a && partTableIndex1[i] == b ) {
< 				idx = i;
< 				break;
< 			    }
< 			}
< 			delete[] idx_tokens;
< 			break;
< 		    default:
< 			idx = atoi(tokenList[1]);
< 			break;
< 		    }
< 		    switch (type) {
< 		    case PotentialSchedule::TYPE:
< 			assert(idx < num); // could add RB-attached and group sites
< 			break;
< 		    case PotentialSchedule::BOND:
< 			assert(idx < numBonds);
< 			break;
< 		    case PotentialSchedule::ANGLE:
< 			assert(idx < numAngles);
< 			break;
< 		    case PotentialSchedule::DIHEDRAL:
< 			assert(idx < numDihedrals);
< 			break;
< 		    }
< 		}
< 		PotentialSchedule sched(type, idx);
< 		
< 		for (int i = 2; i < numTokens-1; i+=2) {
< 		    size_t step;
< 		    try {
< 			step = std::stoul(tokenList[i].val());
< 		    } catch (const std::exception& e) {
< 			// Handle exception (e.g., invalid_argument, out_of_range)
< 			printf("Error: Potential schedule file had unrepresentably large step.\n");
< 			exit(1);
< 		    }
< 		    float val = atof(tokenList[i+1]);
< 		    if (step < 1) {
< 			printf("Error: PotentialSchedule steps should not be less than one. exiting\n");
< 			exit(-1);
< 		    }
< 		    sched.add_control_point(step,val);
< 		}
< 
< 		potential_schedule.push_back(sched);
< 	}
< }
