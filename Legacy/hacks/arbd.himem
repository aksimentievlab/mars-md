         float d2 = dr.length2();
+#if MAX_NLIST_PAIRS > MAX_TEX_SIZE
+        const int& ind = g_pairTabPotType[i];
+#else
         int  ind  = tex1Dfetch<int>(pairTabPotTypeTex,i);
+#endif
