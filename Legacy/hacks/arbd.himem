         {
             Vector3 f = tablePot[ind]->computef(dr,d2);
+	    // if (ai == 0 || aj == 0)
+	    // 	printf("tabForce %d %d: %f %f %f\n", ai, aj, f.x, f.y, f.z);
             atomicAdd( &force[ai],  f );
             atomicAdd( &force[aj], -f );
         }
