< 	//assert(home1 >= 0);
< 	//assert(home1 < d->size);
< 
< 	//================================================
< 	// Linear interpolation
< 	float U0 = d->pot[home];       // Potential
< 	float dUdx = (d->pot[home1] - U0); // Change in potential
< 
< 	float e = 0.0f;
<         if(get_energy)
