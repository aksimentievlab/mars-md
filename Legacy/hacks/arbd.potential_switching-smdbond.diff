< void GrandBrownTown::initialize_potential_slopes(size_t first_step) {
<     // Loop over potential switch schedules and update values
<     size_t next_step;
<     do {
< 	next_step = SIZE_MAX;
< 	for (auto& ps: potential_schedule) {
< 	    if (ps.next_step == 0) continue;
< 	    if (ps.next_step < next_step) {
< 		next_step = ps.next_step;
< 	    }
< 	}
< 	if (next_step < first_step) {
< 	    // printf("Initializing potentials at step %zu\n", next_step);
< 	    update_potential_slopes(next_step);
< 	}
<     } while (next_step < first_step);
< }
