< void GrandBrownTown::update_potential_slopes(size_t step, size_t first_step) {
<     step += first_step;
<     // Loop over potential switch schedules and update values
<     float any_schedule_updates = false;
<     for (auto& ps: potential_schedule) {
< 	// printf( "\n  step %zu: Checking for ps.next_step %zu (%d)\n", step, ps.next_step, ps.next_step == step);
< 	if (ps.next_step == step) {
< 	    // printf( "\n  step %zu: Found ps.next_step\n", step);
< 	    
< 	    if (!any_schedule_updates) {
< 		any_schedule_updates = true;
< 		gpuman.sync();
< 	    }
< 	    ps.get_value(step);
< 	    // printf( "  ps.(slope,int): %g %0.2f\n", ps.slope, ps.intercept);
< 
< 	    float2 tmp = make_float2(ps.slope,ps.intercept);
< 
< 	    assert( gpuman.gpus.size() == 1 ); // Single GPU implementation only
< 		  
< 	    float2* dest;
< 	    switch (ps.potential_type) {
< 	    case PotentialSchedule::TYPE:
< 		dest = internal->getTypeSlopes_d();
< 		{
< 		int _offset = ps.potential_index; // actually atom index
< 		assert( _offset != -1 );
< 		// printf("   Updating type %d slope to (%g,%.2f)\n", _offset, tmp.x, tmp.y);
< 		gpuErrchk( cudaMemcpyAsync( dest+_offset, &tmp, sizeof(float2), cudaMemcpyHostToDevice) );
< 		}
< 		break;
< 	    case PotentialSchedule::NONBONDED:
< 		dest = internal->getNonbondedSlopes_d();
< 		{
< 		    int2 offsets =  nonbondedSlopeIds[ps.potential_index];
< 		assert( offsets.x != -1 );
< 		assert( offsets.y != -1 );
< 		// printf("   Updating bond potential %d slope to (%g,%.2f)\n", idx, tmp.x, tmp.y);
< 		gpuErrchk( cudaMemcpyAsync( dest+offsets.x, &tmp, sizeof(float2), cudaMemcpyHostToDevice) );
< 		gpuErrchk( cudaMemcpyAsync( dest+offsets.y, &tmp, sizeof(float2), cudaMemcpyHostToDevice) );
< 		}
< 		break;
< 	    case PotentialSchedule::BOND:
< 		dest = internal->getBondSlopes_d();
< 		for(int k = 0 ; k < numReplicas; k++) {
< 		    int _offset =  bondSlopeIds[ps.potential_index];
< 		    assert( _offset != -1 );
< 		    size_t idx = k * (numBonds/2) + _offset;
< 		    // printf("   Updating bond potential %d slope to (%g,%.2f)\n", idx, tmp.x, tmp.y);
< 		    gpuErrchk( cudaMemcpyAsync( dest+idx, &tmp, sizeof(float2), cudaMemcpyHostToDevice) );
< 		}
< 		break;
< 	    case PotentialSchedule::SMDBOND:
< 		dest = internal->getSMDBondSlopes_d();
< 		for(int k = 0 ; k < numReplicas; k++) {
< 		    int _offset =  ps.potential_index;
< 		    assert( _offset != -1 );
< 		    size_t idx = k * (num_smd_bonds) + _offset;
< 		    // printf("   Updating smdbond potential %d slope to (%g,%.2f)\n", idx, tmp.x, tmp.y);
< 		    gpuErrchk( cudaMemcpyAsync( dest+idx, &tmp, sizeof(float2), cudaMemcpyHostToDevice) );
< 		}
< 		break;
< 	    case PotentialSchedule::ANGLE:
< 		dest = internal->getAngleSlopes_d();
< 		for(int k = 0 ; k < numReplicas; k++) {
< 		    int _offset =  angleSlopeIds[ps.potential_index];
< 		    assert( _offset != -1 );
< 		    size_t idx = k * (numAngles) + _offset;
< 		    // printf("   Updating angle potential %d slope to (%g,%.2f)\n", idx, tmp.x, tmp.y);
< 		    gpuErrchk( cudaMemcpyAsync( dest+idx, &tmp, sizeof(float2), cudaMemcpyHostToDevice) );
< 		}
< 		break;
< 	    case PotentialSchedule::DIHEDRAL:
< 		dest = internal->getDihedralSlopes_d();
< 		for(int k = 0 ; k < numReplicas; k++) {
< 		    int _offset =  dihedralSlopeIds[ps.potential_index];
< 		    assert( _offset != -1 );
< 		    size_t idx = k * (numDihedrals) + _offset;
< 		    // printf("   Updating dihedral potential %d slope to (%g,%.2f)\n", idx, tmp.x, tmp.y);
< 		    gpuErrchk( cudaMemcpyAsync( dest+idx, &tmp, sizeof(float2), cudaMemcpyHostToDevice) );
< 		}
< 		break;
< 	    default:
< 		throw("ERROR");
< 	    }
< 	}
<     }
<     if (any_schedule_updates) gpuman.sync();
< };
