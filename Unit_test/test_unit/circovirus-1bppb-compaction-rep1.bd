seed 71891
timestep 2e-05
steps 100000000
numberFluct 0                   # deprecated
interparticleForce 1            # other values deprecated
fullLongRange 0                 # deprecated
temperature 291
ParticleDynamicType Langevin

outputPeriod 10000.0
## Energy doesn't actually get printed!
outputEnergyPeriod 10000.0
outputFormat dcd

## Infrequent domain decomposition because this kernel is still very slow
decompPeriod 100
cutoff 50
pairlistDistance 150

origin -2500.0 -2500.0 -2500.0
systemSize 5000 5000 5000




particle D000
num 530
mass 300.0
transDamping 500 500 500
gridFile ../capsid.dsDNA.0.dx
gridFileScale 0.2
gridFileScaleSlope 1.8e-08
gridFileSMD -2.3219281e-08

particle O000
num 530
mass 300.0
transDamping 500 500 500
gridFile potentials/null.dx

particle S000
num 738
mass 150.0
transDamping 500 500 500
gridFile ../capsid.ssDNA.0.dx
gridFileScale 0.1
gridFileScaleSlope 9e-09
gridFileSMD -2.3219281e-08

## Input coordinates
inputParticles circovirus-1bppb-compaction-rep1.particles.txt


## Interaction potentials
tabulatedPotential  1
## The i@j@file syntax means particle type i will have NB interactions with particle type j using the potential in file
tabulatedFile 0@0@potentials/circovirus-1bppb-compaction-rep1-nb.D000-D000.dat
tabulatedFile 0@1@potentials/circovirus-1bppb-compaction-rep1-nb.D000-O000.dat
tabulatedFile 0@2@potentials/circovirus-1bppb-compaction-rep1-nb.D000-S000.dat
tabulatedFile 1@1@potentials/circovirus-1bppb-compaction-rep1-nb.O000-O000.dat
tabulatedFile 1@2@potentials/circovirus-1bppb-compaction-rep1-nb.O000-S000.dat
tabulatedFile 2@2@potentials/circovirus-1bppb-compaction-rep1-nb.S000-S000.dat
tabulatedBondFile ./potentials/bond-30.000-1.500.dat
tabulatedBondFile ./potentials/bond-3.000-18.500.dat
tabulatedBondFile ./potentials/gbond-2.822-5.100.dat
tabulatedBondFile ./potentials/wlcbond-6.400-12.000.dat
tabulatedBondFile ./potentials/bond-4.000-12.000.dat
tabulatedBondFile ./potentials/wlcbond-6.400-12.000.dat
tabulatedBondFile ./potentials/wlcbond-6.400-12.000.dat
tabulatedBondFile ./potentials/wlcbond-6.400-12.000.dat
tabulatedBondFile ./potentials/gbond-4.233-3.400.dat
tabulatedBondFile ./potentials/wlcbond-6.400-12.000.dat
tabulatedBondFile ./potentials/bond-4.000-18.500.dat
tabulatedAngleFile ./potentials/wlcangle-12.800-12.000.dat
tabulatedAngleFile ./potentials/angle-13.913-90.000.dat
tabulatedAngleFile ./potentials/angle-20.882-90.000.dat
tabulatedAngleFile ./potentials/wlcangle-12.800-12.000.dat
tabulatedAngleFile ./potentials/wlcangle-12.800-12.000.dat
tabulatedAngleFile ./potentials/wlcangle-12.800-12.000.dat
tabulatedAngleFile ./potentials/angle-25.015-180.000.dat
tabulatedAngleFile ./potentials/angle-31.289-180.000.dat
tabulatedAngleFile ./potentials/wlcangle-12.800-12.000.dat
tabulatedDihedralFile ./potentials/dihedral-76.537-34.483.dat
tabulatedDihedralFile ./potentials/dihedral-8.338-180.000.dat
